{
  "name": "nacosfuto-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:website",
    "dev:all": "concurrently \"npm run dev:website\" \"npm run dev:portal\"",
    "dev:website": "npm --prefix apps/website run dev",
    "dev:portal": "npm --prefix apps/portal run dev",
    "build": "npm run build:website && npm run build:portal",
    "build:website": "npm --prefix apps/website run build",
    "build:portal": "npm --prefix apps/portal run build",
    "lint": "npm --prefix apps/website run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
