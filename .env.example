# =============================================================================
# NACOS FUTO Monorepo Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE (SYSTEM OF RECORD)
# Core database, user accounts, RLS policies, payment & academic records
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# 2. CLOUDINARY (MEDIA INFRASTRUCTURE - CLIENT-SIDE CONFIG)
# Exposed to the browser with VITE_ prefix. DO NOT put API Secret here.
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=nacos-futo
VITE_CLOUDINARY_UPLOAD_PRESET=nacos_portal_preset

# -----------------------------------------------------------------------------
# 3. CLOUDINARY (MEDIA INFRASTRUCTURE - SERVER-SIDE SECRET CONFIG)
# Used ONLY by Vercel Serverless Functions (/api/cloudinary/*) and Node dev server.
# NEVER expose CLOUDINARY_API_SECRET to client-side code or browser bundles!
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=nacos-futo
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# 4. EMAIL SERVICE CONFIGURATION (SMTP / NODEMAILER & RESEND)
# Supports SMTP (Gmail, institutional mail, cPanel) with Resend fallback
# -----------------------------------------------------------------------------
# Active Provider: 'smtp' | 'resend' (auto-selects smtp if configured, else resend)
EMAIL_PROVIDER=smtp

# --- SMTP Configuration (Nodemailer) ---
# For Gmail: host=smtp.gmail.com, port=465, secure=true (use a 16-character App Password)
# For cPanel/Webmail: host=mail.yourdomain.com, port=465 (SSL) or 587 (TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="NACOS FUTO" <no-reply@nacosfuto.org.ng>

# --- Resend Configuration (Retained for future / fallback) ---
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=NACOS FUTO <onboarding@resend.dev>
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM=NACOS FUTO <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# 5. PHONE CODE VERIFICATION (POWERED BY TERMII)
# https://termii.com
# -----------------------------------------------------------------------------
# Client-side (Optional overrides):
VITE_SMS_PROVIDER=api

# Server-side (Set in root .env or Vercel Dashboard):
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=dnd


# -----------------------------------------------------------------------------
# 6. APPLICATION DEPLOYMENT
# -----------------------------------------------------------------------------
PORT=5173
NODE_ENV=production
