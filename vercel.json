{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/portal/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}