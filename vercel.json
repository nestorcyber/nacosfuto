{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/portal-admin",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/portal-admin/((?!.*\\.).*)",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!.*\\.).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/((?!.*\\.).*)",
      "destination": "/portal/index.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}