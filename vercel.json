{
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "portal\\..*" }],
      "destination": "/portal/index.html"
    },
    {
      "source": "/((?!api/)(?!portal/)(?!assets/)(?!.*\\.).*)",
      "has": [{ "type": "host", "value": "portal\\..*" }],
      "destination": "/portal/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin\\..*" }],
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/((?!api/)(?!portal-admin/)(?!assets/)(?!.*\\.).*)",
      "has": [{ "type": "host", "value": "admin\\..*" }],
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/portal-admin",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/portal-admin/((?!.*\\.).*)",
      "destination": "/portal-admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!.*\\.).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/((?!.*\\.).*)",
      "destination": "/portal/index.html"
    },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}